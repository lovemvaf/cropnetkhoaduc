# ==========================================
# CROPNET ĐỒNG NAI AI - ENVIRONMENT TEMPLATE
# Cuộc thi: AI Digital Business Challenge 2026 (DiGiFest)
# ==========================================

# ------------------------------------------
# 1. ENVIRONMENT MODE
# ------------------------------------------
NODE_ENV=development

# ------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# (Hệ thống có chế độ Dual-Mode: Tự động dùng dbFallback nếu DB chưa cài đặt)
# ------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cropnet?schema=public"

# ------------------------------------------
# 3. BACKEND CONFIGURATIONS (Express Server)
# ------------------------------------------
PORT=5000
BACKEND_URL=http://localhost:5000
# Trong môi trường production, JWT_SECRET phải có tối thiểu 32 ký tự ngẫu nhiên
JWT_SECRET="cropnet-dongnai-ai-secure-secret-key-2026-min32chars"
JWT_REFRESH_SECRET="cropnet-dongnai-ai-refresh-secure-secret-2026-min32chars"
JWT_EXPIRES_IN="1d"
FRONTEND_ORIGIN=http://localhost:3000

# ------------------------------------------
# 4. FRONTEND CONFIGURATIONS (Next.js Application)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# 5. AI COPILOT CONFIGURATION (Google Gemini Flash)
# (Để trống để tự động chạy Offline Hybrid Deterministic Expert Engine)
# ------------------------------------------
GEMINI_API_KEY=""
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_MODEL="deepseek-v4-flash"
# ------------------------------------------
# 6. THIRD-PARTY MEDIA STORAGE (Cloudinary - Tùy chọn)
# ------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------
# 7. THIRD-PARTY PAYMENT PORTAL (MoMo Sandbox - Tùy chọn)
# ------------------------------------------
MOMO_PARTNER_CODE="MOMOBKUN20180529"
MOMO_ACCESS_KEY="klm05iv7zzHM51aE"
