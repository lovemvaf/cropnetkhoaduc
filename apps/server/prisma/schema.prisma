datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]

  @@map("roles")
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  passwordHash          String         @map("password_hash")
  fullName              String         @map("full_name")
  phone                 String?        @unique
  avatarUrl             String?        @map("avatar_url")
  roleId                String         @map("role_id")
  role                  Role           @relation(fields: [roleId], references: [id])
  status                String         @default("ACTIVE")
  createdAt             DateTime       @default(now()) @map("created_at")
  supplier              Supplier?
  orders                Order[]
  reviews               Review[]
  forumPosts            ForumPost[]
  forumComments         ForumComment[]
  postLikes             PostLike[]
  postBookmarks         PostBookmark[]
  forumReports          ForumReport[]  @relation("Reporter")
  verificationToken     String?        @map("verification_token")
  isEmailVerified       Boolean        @default(false) @map("is_email_verified")
  resetPasswordToken    String?        @map("reset_password_token")
  resetPasswordExpires  DateTime?      @map("reset_password_expires")
  refreshToken          String?        @map("refresh_token")

  @@map("users")
  @@index([roleId])
}

model Supplier {
  id        String    @id @default(uuid())
  userId    String    @unique @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  farmName  String    @map("farm_name")
  address   String
  latitude  Decimal?  @db.Decimal(10, 8)
  longitude Decimal?  @db.Decimal(11, 8)
  status    String    @default("PENDING")
  products  Product[]

  @@map("suppliers")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          String         @id @default(uuid())
  supplierId  String         @map("supplier_id")
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  categoryId  String         @map("category_id")
  category    Category       @relation(fields: [categoryId], references: [id])
  name        String
  description String         @db.Text
  price       Decimal        @db.Decimal(12, 2)
  unit        String
  stock       Decimal        @db.Decimal(10, 2)
  status      String         @default("ACTIVE")
  createdAt   DateTime       @default(now()) @map("created_at")
  tags        String[]       @default([])
  variants    Json?
  images      ProductImage[]
  batches     TraceBatch[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@map("products")
  @@index([supplierId])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String

  @@map("product_images")
  @@index([productId])
}

model TraceBatch {
  id                String          @id @default(uuid())
  productId         String          @map("product_id")
  product           Product         @relation(fields: [productId], references: [id])
  batchCode         String          @unique @map("batch_code")
  harvestDate       DateTime        @map("harvest_date")
  farmingArea       String          @map("farming_area")
  farmingProcess    String?         @map("farming_process") @db.Text
  qrCodeUrl         String?         @map("qr_code_url")
  logisticsTimeline Json?           @map("logistics_timeline")
  inspectionReports Json?           @map("inspection_reports")
  shipmentInfo      Json?           @map("shipment_info")
  createdAt         DateTime        @default(now()) @map("created_at")
  certifications    Certification[]
  orderItems        OrderItem[]

  @@map("trace_batches")
  @@index([productId])
}

model Certification {
  id         String     @id @default(uuid())
  batchId    String     @map("batch_id")
  batch      TraceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name       String
  issuer     String
  status     String     @default("PENDING")
  validUntil DateTime   @map("valid_until")
  imageUrl   String     @map("image_url")

  @@map("certifications")
  @@index([batchId])
}

model Order {
  id              String      @id @default(uuid())
  customerId      String      @map("customer_id")
  customer        User        @relation(fields: [customerId], references: [id])
  totalAmount     Decimal     @db.Decimal(12, 2) @map("total_amount")
  shippingAddress String      @map("shipping_address")
  receiverName    String      @map("receiver_name")
  receiverPhone   String      @map("receiver_phone")
  status          String      @default("PENDING")
  disputeReason   String?     @map("dispute_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  orderItems      OrderItem[]
  payment         Payment?
  shipment        Shipment?

  @@map("orders")
  @@index([customerId])
}

model OrderItem {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String      @map("product_id")
  product   Product     @relation(fields: [productId], references: [id])
  batchId   String?     @map("batch_id")
  batch     TraceBatch? @relation(fields: [batchId], references: [id])
  quantity  Decimal     @db.Decimal(10, 2)
  price     Decimal     @db.Decimal(12, 2)
  review    Review?

  @@map("order_items")
  @@index([orderId])
  @@index([productId])
  @@index([batchId])
}

model Payment {
  id            String    @id @default(uuid())
  orderId       String    @unique @map("order_id")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod String    @map("payment_method")
  paymentStatus String    @default("PENDING") @map("payment_status")
  transactionId String?   @unique @map("transaction_id")
  amount        Decimal   @db.Decimal(12, 2)
  paidAt        DateTime? @map("paid_at")

  @@map("payments")
}

model Shipment {
  id                String    @id @default(uuid())
  orderId           String    @unique @map("order_id")
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipperName       String?   @map("shipper_name")
  shipperPhone      String?   @map("shipper_phone")
  trackingCode      String?   @unique @map("tracking_code")
  shipStatus        String    @default("PICKING") @map("ship_status")
  estimatedDelivery DateTime? @map("estimated_delivery")
  trackingHistory   Json?     @map("tracking_history")
  updatedAt         DateTime  @default(now()) @map("updated_at")

  @@map("shipments")
}

model Review {
  id          String    @id @default(uuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id])
  orderItemId String    @unique @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  customerId  String    @map("customer_id")
  customer    User      @relation(fields: [customerId], references: [id])
  rating      Int
  comment     String?   @db.Text
  imageUrl    String?   @map("image_url")
  reply       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("reviews")
  @@index([productId])
  @@index([customerId])
}

model ForumPost {
  id          String         @id @default(uuid())
  title       String
  content     String         @db.Text
  authorId    String         @map("author_id")
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes       Int            @default(0)
  isPinned    Boolean        @default(false) @map("is_pinned")
  type        String         @default("POST") // 'POST' | 'ANNOUNCEMENT' | 'NEWS' | 'FARM_STORY' | 'RECIPE' | 'TIP' | 'EDUCATION' | 'SUSTAINABILITY'
  status      String         @default("PUBLISHED") // 'PUBLISHED' | 'DRAFT' | 'HIDDEN'
  tags        String[]       @default([])
  viewsCount  Int            @default(0) @map("views_count")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")
  comments    ForumComment[]
  likesList   PostLike[]
  bookmarks   PostBookmark[]
  reports     ForumReport[]

  @@map("forum_posts")
  @@index([authorId])
}

model ForumComment {
  id        String         @id @default(uuid())
  postId    String         @map("post_id")
  post      ForumPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String         @map("author_id")
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String         @db.Text
  parentId  String?        @map("parent_id")
  parent    ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ForumComment[] @relation("CommentReplies")
  status    String         @default("PUBLISHED") // 'PUBLISHED' | 'HIDDEN'
  createdAt DateTime       @default(now()) @map("created_at")
  reports   ForumReport[]

  @@map("forum_comments")
  @@index([postId])
  @@index([authorId])
}

model PostLike {
  id        String    @id @default(uuid())
  postId    String    @map("post_id")
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostBookmark {
  id        String    @id @default(uuid())
  postId    String    @map("post_id")
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@map("post_bookmarks")
}

model ForumReport {
  id         String        @id @default(uuid())
  reporterId String        @map("reporter_id")
  reporter   User          @relation(name: "Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?       @map("post_id")
  post       ForumPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?       @map("comment_id")
  comment    ForumComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason     String
  status     String        @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt  DateTime      @default(now()) @map("created_at")

  @@map("forum_reports")
}

